# ==============================================================================
# Document Scan Management - Environment Configuration Template
# Copy this file to .env and fill in your actual Azure credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
APP_SECRET_KEY=replace_with_a_secure_random_key_for_production

# ==============================================================================
# 1. Azure SQL Server Configuration
# ==============================================================================
# You can provide individual parameters OR a full connection string:
AZURE_SQL_SERVER=your-azure-sql-server.database.windows.net
AZURE_SQL_DATABASE=docscan_db
AZURE_SQL_USER=sqladmin
AZURE_SQL_PASSWORD=YourSecureAzureSqlPassword123!
AZURE_SQL_PORT=1433

# Optional: Full connection string (overrides individual parameters if provided)
# AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=docscan_db;Uid=sqladmin;Pwd=YourSecureAzureSqlPassword123!;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Set to true to fall back to local SQLite if Azure SQL is unreachable or unconfigured
FALLBACK_TO_LOCAL_SQLITE=True


# ==============================================================================
# 2. Azure Account Storage Service (Blob Storage)
# ==============================================================================
# Provide either Connection String OR Account Name + Key:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=your_azure_storage_account_key==;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=scanned-documents

# Alternatively:
# AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
# AZURE_STORAGE_ACCOUNT_KEY=your_azure_storage_account_key==

# Set to true to fall back to local disk storage if Azure Storage is unconfigured
FALLBACK_TO_LOCAL_STORAGE=True


# ==============================================================================
# 3. Azure Content Understanding Service / Document Intelligence
# ==============================================================================
# Azure Content Understanding / Document Intelligence Endpoint and Key
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://your-content-understanding.cognitiveservices.azure.com/
AZURE_CONTENT_UNDERSTANDING_KEY=your_azure_content_understanding_key_here
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2024-11-30-preview

# Alternative Document Intelligence settings (if using standard Document Intelligence resource):
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intelligence.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_doc_intelligence_key_here

# Enable realistic mock analysis when Azure Content Understanding is unconfigured
MOCK_ANALYZER_WHEN_UNCONFIGURED=True


# ==============================================================================
# 4. Optional: LLM Configuration for AI Agent (Azure OpenAI / OpenAI)
# ==============================================================================
# If provided, the AI Agent uses this for natural language synthesis;
# if omitted, the built-in intelligent rule-based AI reasoning agent handles all queries!
# AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# OPENAI_API_KEY=sk-...
