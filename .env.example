# ==============================================================================
# Document Scan Management - Environment Configuration Template
# Copy this file to .env and fill in your actual Azure credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
APP_SECRET_KEY=replace_with_a_secure_random_key_for_production

# ==============================================================================
# 1. Azure SQL Server Configuration
# ==============================================================================
# Database Server: ai103server.database.windows.net
# Database Name: AI103
# Authentication Method: SQL Server Authentication
AZURE_SQL_SERVER=ai103server.database.windows.net
AZURE_SQL_DATABASE=AI103
AZURE_SQL_USER=your_sql_admin_username
AZURE_SQL_PASSWORD=your_sql_admin_password
AZURE_SQL_PORT=1433

# Optional: Full ODBC / pyodbc connection string (if preferred over individual parameters):
# AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:ai103server.database.windows.net,1433;Database=AI103;Uid=your_sql_admin_username;Pwd=your_sql_admin_password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Set to true to fall back to local SQLite if Azure SQL is unreachable or unconfigured
FALLBACK_TO_LOCAL_SQLITE=True


# ==============================================================================
# 2. Azure Account Storage Service (Blob Storage)
# ==============================================================================
# Provide either Connection String OR Account Name + Key:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=your_azure_storage_account_key==;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=scanned-documents

# Alternatively:
# AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
# AZURE_STORAGE_ACCOUNT_KEY=your_azure_storage_account_key==

# Set to true to fall back to local disk storage if Azure Storage is unconfigured
FALLBACK_TO_LOCAL_STORAGE=True


# ==============================================================================
# 3. Azure Content Understanding Service
# ==============================================================================
# Azure Content Understanding endpoint & analyzer configuration
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://honan121314-1405-resource.services.ai.azure.com/
AZURE_CONTENT_UNDERSTANDING_KEY={{CONTENT_UNDERSTANDING_KEY}}
AZURE_CONTENT_UNDERSTANDING_ANALYZER_ID=invoice_analyzer
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2025-11-01

# Enable realistic mock/heuristic analyzer when Azure keys are not yet configured or offline
MOCK_ANALYZER_WHEN_UNCONFIGURED=True


# ==============================================================================
# 4. Optional: LLM Configuration for AI Agent (Azure OpenAI / OpenAI)
# ==============================================================================
# If provided, the AI Agent uses this for natural language synthesis;
# if omitted, the built-in intelligent rule-based AI reasoning agent handles all queries!
# AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# OPENAI_API_KEY=sk-...
